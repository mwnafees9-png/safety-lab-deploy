# Safety Lab Aero — install answers. Copy to install.env and fill in.
# Then run:  node configure.js
#
# MODE: self-hosted  (the app runs on YOUR database)  or  browser-only  (data stays on the machine, no backend)
MODE=self-hosted

# --- self-hosted only ---
# Your own Supabase / Postgres project (NOT a Safety Lab address):
DB_URL=https://YOURREF.supabase.co
DB_KEY=your-publishable-anon-key

# Your own AI proxy address (see the deployment guide). Or set AI_OFF=true to run with AI disabled.
AI_ENDPOINT=https://ai.yourcompany.com/v1/ai
AI_OFF=false

# The web address where you host the app (optional; powers "Open in web"). Leave blank if unsure.
WEB_APP_URL=

# Method-corpus retrieval endpoint (optional; leave blank if you are not using it).
CORPUS_ENDPOINT=

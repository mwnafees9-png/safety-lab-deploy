// ============================================================================
// gt_thread.js — v0.2 — the Golden Thread as the Defense-Lab chain of custody.
//
// Replaces the D3 Sankey. Pick an aircraft function → its WHOLE connected model
// renders as branded node cards linked by a gradient "thread", with every
// stale / compromised / obsolete artifact surfaced as a named finding.
//
// v0.2 — shows the ENTIRE thread, nothing projected out: aircraft + system
// (SFHA) failure conditions, allocation AND verification trees, common-cause
// and system-independence, requirements and verification — PLUS the connected
// RAM (reliability) and HF (human-factors) artifacts the safety numbers depend
// on. Columns render in argument order and only when populated, so a sparse
// function stays readable and a rich one shows everything.
//
// DATA-DRIVEN off window._gtvBuildGraph → {nodes, links}. No new libraries
// (emits an SVG string). No RNG, no Date, no eval.
// ============================================================================
(function () {
    'use strict';

    // Full column order, left → right along the safety argument. HF feeds the
    // failure conditions (credibility); RAM feeds the fault trees (the numbers).
    const ORDER = ['func', 'sys', 'hf', 'stpa', 'fc', 'ram', 'fta', 'cca', 'ip', 'req', 'vv'];
    const CNAME = {
        func: 'FUNCTION', sys: 'SYSTEM', hf: 'HUMAN FACTORS', stpa: 'STPA', fc: 'FAILURE CONDITION',
        ram: 'RELIABILITY', fta: 'FAULT TREE', cca: 'COMMON CAUSE', ip: 'INDEPENDENCE',
        req: 'REQUIREMENT', vv: 'VERIFICATION'
    };
    // Per-layer accent (header + card left-rule). Cards stay white (mockup).
    const ACCENT = {
        func: '#2E6FB0', sys: '#1D9E75', hf: '#7A3EA8', stpa: '#6D28D9', fc: '#7F77DD', ram: '#C88A00',
        fta: '#D85A30', cca: '#BA7517', ip: '#0E7490', req: '#D4537E', vv: '#12A150'
    };

    const INK3 = '#586472', MUTE = '#8A94A2', HAIR = '#D9DFE8', RED = '#E23A34', RED_DEEP = '#C0231D';
    const GREEN = '#12A150', AMBER = '#C88A00', BLUE = '#2E6BD6';
    const FLAG = { compromised: RED, stale: AMBER, obsolete: INK3 };

    function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function _clip(str, n) { str = String(str == null ? '' : str); return str.length > n ? str.slice(0, n - 1) + '…' : str; }

    function statusDot(node) {
        const s = (node.sub || '') + ' ' + (node.label || '');
        if (/verified|closed|complete|pass/i.test(s)) return GREEN;
        if (/review|progress|pending/i.test(s)) return AMBER;
        if (/scheduled|planned|open|draft/i.test(s)) return BLUE;
        return null;
    }
    function borderFor(node) {
        if (node.flag) return FLAG[node.flag] || RED;
        if (node.kind === 'vv' && /verified|closed|complete/i.test((node.sub || '') + (node.label || ''))) return GREEN;
        return HAIR;
    }

    // Card geometry.
    const CARD_W = 182, CARD_H = 50, ROW_PITCH = 66, COL_GAP = 54, PAD_TOP = 56, PAD_L = 16;

    function render(host, graph) {
        if (!host) return;
        if (!graph || !graph.nodes || !graph.nodes.length) {
            host.innerHTML = '<div style="padding:48px;text-align:center;color:' + MUTE + ';font-size:13px;">'
                + 'Select an aircraft function above — its golden thread (failure conditions, trees, requirements, verification, plus the reliability and human-factors artifacts they depend on) renders here.</div>';
            return;
        }

        const byKey = {}; graph.nodes.forEach(n => byKey[n.key] = n);
        // Bucket nodes by kind; keep only populated columns, in ORDER. Flagged first.
        const buckets = {}; ORDER.forEach(k => buckets[k] = []);
        graph.nodes.forEach(n => { if (buckets[n.kind]) buckets[n.kind].push(n); });
        ORDER.forEach(k => buckets[k].sort((a, b) => (b.flag ? 1 : 0) - (a.flag ? 1 : 0)));
        const cols = ORDER.filter(k => buckets[k].length);

        // Column slots. SYSTEM and HUMAN FACTORS share ONE column as two stacked,
        // separate lanes — each keeps its own header; the rest are single-kind.
        const STACK_OF = { sys: 'syshf', hf: 'syshf' };
        const slots = [];
        ORDER.forEach(k => {
            if (!buckets[k].length) return;
            const g = STACK_OF[k];
            const last = slots[slots.length - 1];
            if (g && last && last.group === g) last.kinds.push(k);
            else slots.push({ group: g || null, kinds: [k] });
        });
        const SUBGAP = 30, SUBHEAD = 16;   // gap + sub-header room between stacked lanes
        const slotX = slots.map((_, i) => PAD_L + i * (CARD_W + COL_GAP));
        const W = PAD_L + slots.length * CARD_W + (slots.length - 1) * COL_GAP + PAD_L;

        // Position each node; record headers + lane dividers; track tallest slot
        // and the tallest SINGLE-kind lane (skip-links route under that).
        const pos = {}, headers = [], dividers = [];
        let maxBottom = PAD_TOP, laneBottom = PAD_TOP;
        slots.forEach((slot, si) => {
            const x = slotX[si];
            let y = PAD_TOP;
            slot.kinds.forEach((k, ki) => {
                if (ki === 0) { headers.push({ x: x, y: 30, k: k, count: buckets[k].length }); }
                else { y += SUBGAP; dividers.push({ x: x, y: y - 13 }); headers.push({ x: x, y: y, k: k, count: buckets[k].length }); y += SUBHEAD; }
                buckets[k].forEach(n => { pos[n.key] = { x: x, y: y, w: CARD_W, h: CARD_H }; y += ROW_PITCH; });
            });
            if (y > maxBottom) maxBottom = y;
            if (slot.kinds.length === 1 && y > laneBottom) laneBottom = y;
        });
        const COLPITCH = CARD_W + COL_GAP;
        const _span = (a, b) => Math.max(1, Math.round(Math.abs((b.x) - (a.x + a.w)) / COLPITCH));
        let maxSpan = 1;
        (graph.links || []).forEach(L => { const a = pos[L.s], b = pos[L.t]; if (a && b) { const sp = _span(a, b); if (sp > maxSpan) maxSpan = sp; } });
        const _chan = sp => laneBottom + 26 + Math.max(0, sp - 2) * 16;
        const _cy = sp => { const c = _chan(sp); return c + (c - PAD_TOP) * 0.34; };
        const H = Math.max(maxBottom, _cy(maxSpan)) + 40;

        let s = '';
        s += '<svg viewBox="0 0 ' + W + ' ' + H + '" width="' + W + '" style="display:block;font-family:var(--font-mono,ui-monospace,SFMono-Regular,Menlo,monospace);max-width:none;">';
        s += '<defs>'
            + '<linearGradient id="gtThread" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#F2734A"/><stop offset="0.5" stop-color="' + RED + '"/><stop offset="1" stop-color="#A81C33"/></linearGradient>'
            + '<filter id="gtGlow" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="' + RED + '" flood-opacity="0.3"/></filter>'
            + '</defs>';

        // Column / lane headers.
        s += '<g font-size="10" font-weight="700" letter-spacing="1.8">';
        headers.forEach(h => {
            s += '<text x="' + (h.x + CARD_W / 2) + '" y="' + h.y + '" text-anchor="middle" fill="' + (ACCENT[h.k] || MUTE) + '">' + CNAME[h.k]
                + ' <tspan fill="' + MUTE + '">(' + h.count + ')</tspan></text>';
        });
        s += '</g>';
        // Faint divider between stacked sub-lanes (SYSTEM | HUMAN FACTORS).
        dividers.forEach(d => { s += '<line x1="' + d.x + '" y1="' + d.y + '" x2="' + (d.x + CARD_W) + '" y2="' + d.y + '" stroke="' + HAIR + '" stroke-width="1" stroke-dasharray="3,3"/>'; });

        // Links under nodes.
        s += '<g fill="none" stroke="url(#gtThread)">';
        (graph.links || []).forEach(L => {
            const a = pos[L.s], b = pos[L.t];
            if (!a || !b) return;
            // only draw left→right (skip any back-edge from column ordering)
            let x0 = a.x + a.w, y0 = a.y + a.h / 2, x1 = b.x, y1 = b.y + b.h / 2;
            if (x1 < x0) { const _a = pos[L.t], _b = pos[L.s]; x0 = _a.x + _a.w; y0 = _a.y + _a.h / 2; x1 = _b.x; y1 = _b.y + _b.h / 2; }
            const tn = byKey[L.t];
            const flagged = tn && tn.flag;
            const span = _span(a, b);
            let d;
            if (span >= 2) {
                // Skip-column link: route through a channel BELOW the cards so it is
                // never hidden behind the columns it passes over.
                const cy = _cy(span), cxo = Math.min(150, (x1 - x0) * 0.24);
                d = 'M' + x0 + ',' + y0 + ' C' + (x0 + cxo) + ',' + cy + ' ' + (x1 - cxo) + ',' + cy + ' ' + x1 + ',' + y1;
            } else {
                const dx = Math.max(26, (x1 - x0) * 0.45);
                d = 'M' + x0 + ',' + y0 + ' C' + (x0 + dx) + ',' + y0 + ' ' + (x1 - dx) + ',' + y1 + ' ' + x1 + ',' + y1;
            }
            s += '<path data-s="' + esc(L.s) + '" data-t="' + esc(L.t) + '" d="' + d + '" '
                + 'stroke-width="' + (flagged ? 2.6 : 2) + '" opacity="' + (flagged ? 0.95 : 0.75) + '"' + (flagged ? '' : ' filter="url(#gtGlow)"') + '/>';
        });
        s += '</g>';

        // Nodes.
        let findings = 0;
        cols.forEach(k => {
            buckets[k].forEach(n => {
                const p = pos[n.key];
                const bc = borderFor(n);
                const acc = ACCENT[k] || INK3;
                const idc = n.flag ? bc : (bc === GREEN ? '#0E7A3C' : acc);
                s += '<g data-key="' + esc(n.key) + '" style="cursor:pointer;">';
                s += '<rect x="' + p.x + '" y="' + p.y + '" width="' + p.w + '" height="' + p.h + '" rx="6" fill="#fff" stroke="' + bc + '" stroke-width="' + (n.flag ? 1.7 : (bc === HAIR ? 1 : 1.4)) + '"/>';
                // left accent rule
                s += '<rect x="' + p.x + '" y="' + (p.y + 6) + '" width="3" height="' + (p.h - 12) + '" rx="1.5" fill="' + acc + '"/>';
                s += '<text x="' + (p.x + 12) + '" y="' + (p.y + 19) + '" font-size="11" font-weight="700" fill="' + idc + '">' + esc(_clip(n.label, 23)) + '</text>';
                s += '<text x="' + (p.x + 12) + '" y="' + (p.y + 35) + '" font-size="9" fill="' + INK3 + '">' + esc(_clip(n.sub, (n.kind === 'sys' && n.role) ? 15 : 28)) + '</text>';
                if (n.flag) {
                    findings++;
                    s += '<text x="' + (p.x + p.w - 8) + '" y="' + (p.y + 15) + '" text-anchor="end" font-size="7.5" font-weight="700" letter-spacing="0.4" fill="' + (FLAG[n.flag] || RED) + '">' + esc(n.flag.toUpperCase()) + '</text>';
                }
                const dot = statusDot(n);
                if (dot) s += '<circle cx="' + (p.x + p.w - 11) + '" cy="' + (p.y + p.h - 11) + '" r="3.5" fill="' + dot + '"/>';
                // System-lane role badge — one lane, two roles. PRIMARY realizes
                // the function; RESOURCE is a CEA-upstream supporting system whose
                // loss cascades in. Distal (>1 hop) recedes; click routes to CEA.
                if (n.kind === 'sys' && n.role) {
                    const base = n.role === 'primary' ? 'PRIMARY' : 'RESOURCE';
                    const label = (n.role === 'resource' && (n.hops || 1) > 1) ? (base + ' ·' + n.hops) : base;
                    const bcol = n.role === 'primary' ? '#12A150' : '#C88A00';
                    const distal = n.role === 'resource' && (n.hops || 1) >= 2;
                    const bw = label.length * 5.1 + 12;
                    const bx = p.x + p.w - 7 - bw, by = p.y + p.h - 16;
                    s += '<rect x="' + bx + '" y="' + by + '" width="' + bw + '" height="12.5" rx="6.25" fill="' + bcol + '"' + (distal ? ' opacity="0.5"' : '') + '/>';
                    s += '<text x="' + (bx + bw / 2) + '" y="' + (by + 8.9) + '" text-anchor="middle" font-size="7" font-weight="700" letter-spacing="0.3" fill="#fff">' + esc(label) + '</text>';
                }
                s += '<title>' + esc(n.label + (n.sub ? ' — ' + n.sub : '') + (n.flag ? '  [' + n.flag.toUpperCase() + (n.flagReason ? ': ' + n.flagReason : '') + ']' : '')) + '</title>';
                s += '</g>';
            });
        });

        const cap = findings
            ? findings + ' NAMED FINDING' + (findings === 1 ? '' : 'S') + ' ON THIS THREAD · A BROKEN OR STALE LINK IS SURFACED, NEVER A SILENT GAP · EVERY LINK MACHINE-CHECKED'
            : 'EVERY LINK MACHINE-CHECKED · A BROKEN OR STALE LINK IS A NAMED FINDING, NEVER A SILENT GAP · ONE CAUSE → MANY HAZARDS · ONE MITIGATION → MANY REQUIREMENTS';
        s += '<text x="' + (W / 2) + '" y="' + (H - 14) + '" text-anchor="middle" font-size="9" letter-spacing="1.1" fill="' + (findings ? RED_DEEP : MUTE) + '">' + esc(cap) + '</text>';
        s += '</svg>';

        host.innerHTML = s;
        wireInteractivity(host, graph);
    }

    // Interactivity parity with the retired Sankey: click a node → its connected
    // ecosystem in the panel; double-click → the full trace modal with routable
    // pills; hover → light up that node's whole upstream+downstream thread.
    function wireInteractivity(host, graph) {
        const svg = host.querySelector('svg');
        if (!svg) return;
        const nodeEls = svg.querySelectorAll('g[data-key]');
        const linkEls = svg.querySelectorAll('path[data-s]');
        const call = (name, key) => { try { if (typeof window !== 'undefined' && typeof window[name] === 'function') window[name](key, graph); } catch (_) {} };
        function highlight(key) {
            let set; try { set = (typeof window !== 'undefined' && window._gtvThreadSet) ? window._gtvThreadSet(graph, key) : null; } catch (_) { set = null; }
            if (!set) { set = new Set([key]); }
            nodeEls.forEach(n => { n.style.opacity = set.has(n.getAttribute('data-key')) ? '1' : '0.22'; });
            linkEls.forEach(p => { p.style.opacity = (set.has(p.getAttribute('data-s')) && set.has(p.getAttribute('data-t'))) ? '1' : '0.05'; });
        }
        function clearHl() { nodeEls.forEach(n => { n.style.opacity = '1'; }); linkEls.forEach(p => { p.style.opacity = ''; }); }
        nodeEls.forEach(el => {
            const key = el.getAttribute('data-key');
            el.addEventListener('click', () => call('_gtvShowEco', key));
            el.addEventListener('dblclick', ev => { try { ev.preventDefault(); ev.stopPropagation(); } catch (_) {} call('_gtvShowEcoModal', key); });
            el.addEventListener('mouseenter', () => highlight(key));
            el.addEventListener('mouseleave', clearHl);
        });
    }

    if (typeof window !== 'undefined') window.GT_THREAD = { render: render, ORDER: ORDER };
    if (typeof module !== 'undefined') module.exports = { render: render, ORDER: ORDER };
})();
